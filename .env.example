# Backend (Vercel → Settings → Environment Variables)
PADDLE_ENV=sandbox                 # sandbox | production
PADDLE_API_KEY=                    # pdl_sdbx_apikey_… / pdl_live_apikey_… (permissão: customers read)
PADDLE_WEBHOOK_SECRET=             # segredo do destino de notificação /api/paddle-webhook
PADDLE_PRICE_ID=                   # pri_… do OptPaste
RESEND_API_KEY=
LICENSE_EMAIL_FROM="OptPaste <licenca@seudominio.com>"
LICENSE_EMAIL_REPLY_TO=
# KV_REST_API_URL / KV_REST_API_TOKEN são criadas pela integração Upstash da Vercel

# Site (precisam do prefixo VITE_; entram no bundle, então só valores públicos)
VITE_PADDLE_CLIENT_TOKEN=          # test_… (sandbox) ou live_…
VITE_PADDLE_PRICE_ID=              # mesmo pri_… de PADDLE_PRICE_ID
